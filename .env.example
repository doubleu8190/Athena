# ==============================================================================
# Athena v2 全局环境配置规范模板 (.env.example)
# ==============================================================================
# 本文件为 Athena v2 项目的标准权威配置模板，适用于：
#   1. 本地独立进程开发: cp .env.example .env
#   2. 生产环境容器部署: cp .env.example .env.prod
#
# ------------------------------------------------------------------------------
# 常用部署与运维命令速查:
# ------------------------------------------------------------------------------
# 【生产环境 Docker Compose 部署】
#   - 首次部署/执行数据库迁移:
#       docker compose --env-file .env.prod run --rm backend-migration
#   - 启动生产全套服务 (后台运行):
#       docker compose --env-file .env.prod up -d
#   - 查看全栈服务运行日志:
#       docker compose --env-file .env.prod logs -f
#   - 检查服务健康与运行状态:
#       docker compose --env-file .env.prod ps
#   - 停止生产服务:
#       docker compose --env-file .env.prod down
#
# 【本地 Docker 容器化一键测试】
#   - 执行专用测试脚本启动完整测试环境 (自动拉起中间件并测试探活):
#       scripts/test-docker.sh up
#   - 强制重新构建 Base 基础依赖镜像:
#       scripts/test-docker.sh up --build-base
#   - 停止测试环境:
#       scripts/test-docker.sh down
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 网络监听、端口与镜像构建 (Network & Build)
# ------------------------------------------------------------------------------
# 前端 Web 与 Nginx 反向代理服务对外暴露端口（默认标准 HTTP 80）
# 本地开发测试如避免 80 端口权限或冲突可调整为 8080
PORT=80

# 后端镜像构建参数：仅控制是否在镜像打包时安装重量级本地 OCR 可选依赖（PaddlePaddle 与 PaddleOCR）
# 轻量化文本解析与中文分词依赖（jieba/pypdfium2/python-docx/openpyxl/python-pptx/Pillow）已内置为核心依赖；
# 生产环境若无需在应用容器内部执行扫描件/图片本地 OCR，保持 false 即可显著缩减镜像体积与构建时间
ATHENA_INSTALL_KNOWLEDGE=false

# 结构化应用日志级别：生产环境建议设置为 INFO，排查问题时可设为 DEBUG
ATHENA_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. 核心关系型数据库 (PostgreSQL 16+ 配合 pgvector 0.8+)
# ------------------------------------------------------------------------------
# 核心数据库连接串；设置后应用工厂将默认装配认证、项目、会话、消息、MCP、文件/技能与知识库等全部核心服务。
# 格式: postgresql+asyncpg://<username>:<password>@<db-host>:<db-port>/<database>
ATHENA_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/athena

# PostgreSQL 业务连接池参数优化：
# - 本地轻量开发: POOL_SIZE=5, MAX_OVERFLOW=10
# - 生产高并发环境: 推荐 POOL_SIZE=10, MAX_OVERFLOW=20（数据库行锁与工具执行段均会持有业务连接）
ATHENA_DATABASE_POOL_SIZE=5
ATHENA_DATABASE_MAX_OVERFLOW=10

# 可选的 PostgreSQL 集成测试数据库。本地自动化测试会创建并删除临时 schema
ATHENA_TEST_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/athena_test

# ------------------------------------------------------------------------------
# 3. 高性能缓存与事件 Pub/Sub (Redis 7+)
# ------------------------------------------------------------------------------
# Run SSE 实时事件流与任务状态对账连接串；
# 格式: redis://[:password@]<redis-host>:<redis-port>/<db_index>
# 未配置或 Redis 短暂不可用时，系统自动依赖 PostgreSQL 周期对账降级运行，不影响任务最终执行结果。
ATHENA_REDIS_URL=redis://127.0.0.1:6379/0

# ------------------------------------------------------------------------------
# 4. 安全、认证与防跨站攻击 (Security, Auth & Origin)
# ------------------------------------------------------------------------------
# 运行环境标识（development / production）：
# - production 模式下强制要求配置 ATHENA_REDIS_URL，否则 API 进程拒绝启动（防止误用单进程内存限流）。
ATHENA_ENV=development

# 会话认证 Cookie (HttpOnly) 是否仅通过 HTTPS 安全传输：
# - 本地纯 HTTP 调试开发可设为 false；
# - 生产环境（经反向代理或直接 HTTPS）必须设为 true，防止 Cookie 明文被嗅探泄露。
ATHENA_COOKIE_SECURE=false

# 同源部署的规范 Origin（协议+域名+端口），后端用于严格校验浏览器跨站写请求 Origin 标头：
# - 本地开发直连 API 示例: http://127.0.0.1:8000
# - 生产环境完整域名示例: https://athena.example.com （标准 443 端口无需携带端口号）
# 留空时仅接受请求自身解析出的 origin；生产同源部署应显式配置。
ATHENA_PUBLIC_ORIGIN=http://127.0.0.1:8000

# 飞书原生 SSO 与通讯录组织树同步配置：
# - ATHENA_FEISHU_ENABLED=true 时必须填写 APP_ID、APP_SECRET、REDIRECT_URI；
# - 生产环境（ATHENA_ENV=production）开启飞书时强制要求配置 ATHENA_REDIS_URL（一次性 state 原子防重放）且接口与回调必须为 HTTPS。
ATHENA_FEISHU_ENABLED=false
ATHENA_FEISHU_APP_ID=
ATHENA_FEISHU_APP_SECRET=
ATHENA_FEISHU_REDIRECT_URI=
ATHENA_FEISHU_BASE_URL=https://open.feishu.cn

# 非生产本地 Mock 组织与快捷登录开关（仅限开发/测试联调）：
# - 开启后将在启动时幂等预置 Mock 组织树与 6 个典型角色测试账号，并挂载 /api/v1/auth/mock/*；
# - 【生产强安全护栏】ATHENA_ENV=production 且 ATHENA_AUTH_MOCK_ENABLED=true 时 API 进程将立即拒绝启动！
ATHENA_AUTH_MOCK_ENABLED=false

# MCP 协议凭据加密主密钥（在数据库中对敏感凭据与 API Key 进行 AES-GCM 加密，必填 32 字节 Base64 字符串）
# 【生产环境必须生成强随机密钥，严禁留空或使用公开弱密钥！】
# 快速生成命令:
# python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
ATHENA_MCP_SECRET_KEY=
ATHENA_MCP_SECRET_KEY_VERSION=1

# 宿主进程透传至 stdio 模式 MCP 子进程的环境变量名列表（以逗号分隔）；单 Server 凭据单独由后台配置
ATHENA_MCP_STDIO_BASE_ENV_NAMES=

# ------------------------------------------------------------------------------
# 5. 异步任务 Worker 并发与租约参数 (Backend Run Worker Tuning)
# ------------------------------------------------------------------------------
# 独立 Run Worker 工作线程并发度（生产环境多核宿主机建议调整为 8 或更高）
ATHENA_RUN_WORKER_CONCURRENCY=4
# 任务租约有效时长（秒），心跳续租间隔（秒）
ATHENA_RUN_LEASE_SECONDS=30
ATHENA_RUN_HEARTBEAT_SECONDS=5
# 单次 Run 执行最大允许总超时（秒，默认 300 秒，支持长耗时 LLM 推理与工具链调用）
ATHENA_RUN_EXECUTION_SECONDS=300
# 取消信号轮询间隔、就绪队列轮询间隔、租约异常回收对账间隔（秒）
ATHENA_RUN_CANCEL_POLL_SECONDS=1
ATHENA_RUN_QUEUE_POLL_SECONDS=1
ATHENA_RUN_RECLAIM_SECONDS=5

# LLM 与工具调用安全预算限制：
# 每 Run 最大允许应用层 LLM 调用次数
ATHENA_RUN_LLM_REQUEST_LIMIT=40
# 单次工具调用执行超时（秒）
ATHENA_RUN_TOOL_TIMEOUT_SECONDS=30
# 单次工具输入参数与执行结果的最大字节上限（默认 64 KiB）
ATHENA_RUN_TOOL_ARGUMENT_BYTES=65536
ATHENA_RUN_TOOL_RESULT_BYTES=65536
# 工具清理资源的最大允许超时（秒）
ATHENA_RUN_TOOL_CLEANUP_SECONDS=10
# 同一模型响应中并行工具调用批次上限与实际最大执行并发
ATHENA_RUN_TOOL_BATCH_LIMIT=8
ATHENA_RUN_TOOL_CONCURRENCY=4

# ------------------------------------------------------------------------------
# 6. 统一对象存储：会话附件、技能文件与知识库原件 (MinIO / S3，必填基础设施)
# ------------------------------------------------------------------------------
# 文件/技能与知识库均已收敛为后端默认无条件装配的核心能力：
# 知识库原件（knowledge/）与会话附件/技能文件（session-files/、session-files-extracted/、
# session-artifacts/、skill-logs/、skills/）共用一套私有 S3/MinIO 配置，在单桶内通过前缀严格隔离；
# 存储桶必须提前预建并保持私有权限；以下 ATHENA_STORAGE_* 若缺失或 bucket 不可用会在启动阶段 Fail-Fast 报错。
# 对象存储端点（host[:port]，不含协议或路径前缀），例如 127.0.0.1:9000 或 s3.amazonaws.com
ATHENA_STORAGE_ENDPOINT=
ATHENA_STORAGE_ACCESS_KEY=
ATHENA_STORAGE_SECRET_KEY=
ATHENA_STORAGE_BUCKET=
# TLS 开关：只接受 true/false、1/0、yes/no、on/off
ATHENA_STORAGE_SECURE=true

# 私有 CA 证书路径（可选；若配置则让 SSL_CERT_FILE 指向私有根证书，未设置时沿用系统信任库）
# SSL_CERT_FILE=/path/to/private-ca.pem

# 技能运行时宿主环境配置：
# 脚本运行建议指向专用虚拟环境及宿主机专用可写目录；未显式指定时使用当前进程解释器与系统临时目录。
# ATHENA_SKILL_PYTHON_EXECUTABLE=/absolute/path/to/venv/bin/python
ATHENA_SKILL_TEMP_ROOT=./var/skill-executions

# ------------------------------------------------------------------------------
# 7. 知识库与无状态远程 Embedding 服务 (OpenAI-Compatible，必填基础设施)
# ------------------------------------------------------------------------------
# 知识库管理与 RAG 检索默认随 API、run_worker 与 backend-knowledge-worker 全栈装配；
# docker compose up 会默认一并启动 backend-knowledge-worker，共用同一数据库、统一 ATHENA_STORAGE_* 与远程 Embedding 服务。
ATHENA_KNOWLEDGE_SEMANTIC_MIN_SCORE=0.35

# OpenAI 兼容远程 Embedding 服务配置（如 Ollama、vLLM、Xinference、OpenAI、SiliconFlow 等）
# 必填项，仅允许 http:// 或 https://，禁止包含凭据片段（如 http://127.0.0.1:11434/v1 或 http://127.0.0.1:8001/v1）
ATHENA_EMBEDDING_BASE_URL=
# 可选；内网无鉴权服务可留空，提供时以 Authorization: Bearer <key> 发送
ATHENA_EMBEDDING_API_KEY=
# 模型名称与输出维度（须与 PostgreSQL knowledge_chunks Vector(1024) 列一致）
ATHENA_EMBEDDING_MODEL=BAAI/bge-m3
ATHENA_EMBEDDING_DIMENSIONS=1024
# 请求体是否发送 dimensions 字段（部分旧版 OpenAI 兼容后端不支持时可设为 false）
ATHENA_EMBEDDING_SEND_DIMENSIONS=true
# 单次 HTTP 超时（秒）与批量切片大小
ATHENA_EMBEDDING_TIMEOUT_SECONDS=30.0
ATHENA_EMBEDDING_BATCH_SIZE=32

# 知识库解析与任务并发参数：
# 知识库 Worker 并发处理数
ATHENA_KNOWLEDGE_WORKER_CONCURRENCY=2
ATHENA_KNOWLEDGE_OWNER_CONCURRENCY=2
# PaddleOCR 离线模型本地持久化缓存路径
ATHENA_KNOWLEDGE_OCR_CACHE_ROOT=./var/paddle-cache

# 可选的真实 MinIO 本地集成测试专用配置（必须与生产环境隔离）：
# ATHENA_TEST_MINIO_ENDPOINT=
# ATHENA_TEST_MINIO_ACCESS_KEY=
# ATHENA_TEST_MINIO_SECRET_KEY=
# ATHENA_TEST_MINIO_BUCKET=
# ATHENA_TEST_MINIO_SECURE=true

# ==============================================================================
# 【生产上线前安全自检清单 (Pre-Flight Security Checklist)】
# ==============================================================================
# 部署至公网或正式生产环境前，请逐一核对以下项目：
# [ ] 1. ATHENA_DATABASE_URL 已指向独立的生产 PostgreSQL 16+ 实例，且已执行数据库结构迁移。
# [ ] 2. ATHENA_DATABASE_POOL_SIZE 与 MAX_OVERFLOW 已根据预期并发调优（推荐 10 与 20）。
# [ ] 3. ATHENA_ENV 已设为 production，且 ATHENA_REDIS_URL 已配置带强密码保护的高可用 Redis 实例（生产模式缺失 Redis 将阻断启动）。
# [ ] 4. ATHENA_MCP_SECRET_KEY 已通过 secrets.token_bytes(32) 生成强随机密钥并妥善备份。
# [ ] 5. ATHENA_COOKIE_SECURE 已设为 true，且外部反向代理已正确配置 HTTPS/TLS 证书。
# [ ] 6. ATHENA_PUBLIC_ORIGIN 已准确配置为用户浏览器访问的完整规范公网域名（如 https://athena.example.com）。
# [ ] 7. ATHENA_AUTH_MOCK_ENABLED 确认保持 false；已通过 backend/src/cli/bootstrap_super_admin.py 初始化本地应急 super_admin 账号。
# [ ] 8. ATHENA_STORAGE_* 已指向预建的私有 S3/MinIO 桶，ATHENA_EMBEDDING_BASE_URL 已指向 1024 维 OpenAI 兼容服务，且 backend-knowledge-worker 随栈默认启动。
# [ ] 9. 若开启飞书 SSO（ATHENA_FEISHU_ENABLED=true），已妥善配置 HTTPS 回调与 APP_SECRET，并完成首次通讯录同步。
# [ ] 10. 生产部署的真实配置文件 (.env.prod) 权限已设为仅所属者可读 (chmod 600 .env.prod)，确认未被 Git 跟踪。
# ==============================================================================
