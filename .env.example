# ============================================================
# Athena 配置示例 — 复制为 .env 后按需修改
# ============================================================

# --- Server ---
HOST=127.0.0.1
PORT=8000
DEBUG=true

# --- LangSmith observability (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=athena
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=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

# --- Web Authentication ---
# 本机开发可保持关闭；绑定非 loopback 地址时必须开启。
AUTH_ENABLED=false
AUTH_USERNAME=athena
AUTH_PASSWORD=change-me
# 生产环境请使用至少 32 字节的随机密钥
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=24
AGENT_RUNTIME_ENGINE=langgraph

# --- LLM Providers ---
# 按优先级排列：primary(主) → secondary(副,模型能力稍弱) → fallback(兜底容灾)
# JSON 数组格式，每项字段：name / provider / model / api_key / base_url / temperature / max_tokens / supports_vision
# temperature / max_tokens 设为 -1 表示使用下方全局默认值
LLM_PROVIDERS='[{"name":"primary","provider":"openai","model":"gpt-4o","api_key":"sk-your-api-key-here"},{"name":"secondary","provider":"openai","model":"gpt-4o-mini","api_key":"sk-your-api-key-here"},{"name":"fallback","provider":"ollama","model":"qwen2.5:14b","base_url":"http://localhost:11434"}]'
# 全局 LLM 默认参数（provider 级别设为 -1 时回退到此处）
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
# 主 Provider 重试策略（最大尝试次数包含首次调用）
LLM_RETRY__MAX_ATTEMPTS=3
LLM_RETRY__MIN_DELAY_MS=2000
LLM_RETRY__MAX_DELAY_MS=30000
LLM_RETRY__JITTER=0.1
LLM_RETRY__TIMEOUT_MS=60000
# 副 Provider 使用更轻量的重试策略
LLM_SECONDARY_RETRY__MAX_ATTEMPTS=2
LLM_SECONDARY_RETRY__MIN_DELAY_MS=1000
LLM_SECONDARY_RETRY__MAX_DELAY_MS=15000
LLM_SECONDARY_RETRY__JITTER=0.1
LLM_SECONDARY_RETRY__TIMEOUT_MS=30000

# --- PostgreSQL ---
POSTGRES_USER=doubleu
POSTGRES_PASSWORD=
POSTGRES_DB=athena
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
# 中文/多语言向量默认使用本地 Sentence Transformers 模型。
# 可选 provider：sentence_transformers、openai、ollama。
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_VERSION=v2
EMBEDDING_DIMENSION=1024
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# --- Neo4j / Graph RAG ---
# Disabled by default; enabling Neo4j alone only initializes the storage
# adapter. Graph retrieval is enabled separately after indexing is implemented.
NEO4J_ENABLED=false
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=20
NEO4J_CONNECTION_TIMEOUT_SECONDS=5
NEO4J_QUERY_TIMEOUT_SECONDS=5
NEO4J_FAIL_OPEN=true
GRAPH_RAG_ENABLED=false
GRAPH_MAX_HOPS=2
GRAPH_ENTITY_LIMIT=8
GRAPH_PATH_LIMIT=12
GRAPH_MIN_CONFIDENCE=0.65
GRAPH_EXTRACTION_CONCURRENCY=2
GRAPH_TIMEOUT_SECONDS=5

FILE_STORAGE_PATH=./data/files
FILE_MAX_UPLOAD_BYTES=536870912
FILE_CHUNK_TOKENS=800
FILE_CHUNK_OVERLAP_TOKENS=80
FILE_TASK_MAX_ATTEMPTS=3
FILE_TASK_TIMEOUT=900
FILE_TASK_POLL_INTERVAL=0.25
FILE_PARSE_CONCURRENCY=2
FILE_CODE_CONCURRENCY=1
FILE_SUMMARY_CONCURRENCY=4
FILE_EMBEDDING_CONCURRENCY=2
# --- File / Knowledge Retrieval Reranking ---
# 启用本地 Cross-Encoder；模型在应用启动时加载。
FILE_RERANK_ENABLED=true
# true 时模型加载失败会阻止应用启动；false 时回退到 RRF 排序。
FILE_RERANK_REQUIRED=false
FILE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 留空时自动选择；也可指定 cpu、cuda 或 mps。
FILE_RERANK_DEVICE=
FILE_RERANK_BATCH_SIZE=16
FILE_RERANK_MAX_CHARS=4000
# 单文件检索：每路召回候选池、进入 rerank 的数量。
FILE_RERANK_CANDIDATE_K=50
FILE_RERANK_K=20
# 知识库全局检索：每路召回候选池、进入 rerank 的数量。
KNOWLEDGE_RERANK_CANDIDATE_K=100
KNOWLEDGE_RERANK_K=30
PDF_OCR_MIXED_PAGES=true
PDF_OCR_MIN_IMAGE_PIXELS=4096
PDF_OCR_MAX_IMAGES_PER_PAGE=20
FILE_ARCHIVE_MAX_ENTRIES=10000
FILE_ARCHIVE_MAX_UNCOMPRESSED_BYTES=2147483648
FILE_ARCHIVE_MAX_RATIO=100

# --- Harness ---
MAX_TURNS_PER_RUN=20
RETRY_BUDGET=3
TOOL_TIMEOUT=60
LLM_STREAM_TIMEOUT=120
APPROVAL_TIMEOUT=120

# --- Memory ---
SUMMARY_THRESHOLD=10
MEMORY_SYNC_INTERVAL=900
MEMORY_MIN_SCORE=0.7
MEMORY_TTL_DAYS=90
MEMORY_ACCESS_WINDOW_DAYS=7
VECTOR_WEIGHT=0.75
KEYWORD_WEIGHT=0.25
RRF_K=60
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=30
RETRIEVAL_RERANK_K=10
RETRIEVAL_CONTEXT_K=5
MEMORY_VECTOR_MIN_SCORE=0.70
MEMORY_MAX_TOKENS=2000
MEMORY_RETRIEVAL_TIMEOUT_SECONDS=3.0

# --- Task Understanding / Knowledge Context ---
TASK_UNDERSTANDING_TIMEOUT_SECONDS=120.0
KNOWLEDGE_CONTEXT_MAX_FILES=5
KNOWLEDGE_CONTEXT_LIMIT_PER_FILE=5
KNOWLEDGE_CONTEXT_MAX_ITEMS=12
KNOWLEDGE_CONTEXT_MAX_TOKENS=4000

# --- Context Compression ---
MAX_CONTEXT_TOKENS=128000
COMPRESSION_THRESHOLD=0.8
KEEP_RECENT_TURNS=3
MAX_SUMMARY_TOKENS=2000
SUMMARY_INCREMENTAL=true
SAVE_SUMMARY_TO_MEMORY=true

# --- Docker Sandbox (可选，默认禁用) ---
SANDBOX_ENABLED=false
SANDBOX_IMAGE=athena-sandbox:latest
SANDBOX_NETWORK_DISABLED=true
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_WORKSPACE_PATH=/workspace
SANDBOX_CHECK_INTERVAL=300
# 允许挂载的宿主路径白名单（逗号分隔）
SANDBOX_ALLOWED_PATHS=

# --- Approval ---
APPROVAL_BATCH_MODE=sequential
APPROVAL_KEYBOARD_SHORTCUTS=true
APPROVAL_SOUND_ALERT=false
