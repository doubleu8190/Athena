# 应用数据库；设置后 create_app 会组装认证、项目和消息服务。
ATHENA_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/athena

# PostgreSQL 业务连接池容量。数据库行锁等待会占用一条业务连接。
ATHENA_DATABASE_POOL_SIZE=5
ATHENA_DATABASE_MAX_OVERFLOW=10

# 登录 Cookie 是否仅通过 HTTPS 发送。仅本地 HTTP 开发可设为 false；
# 生产环境必须设为 true。
ATHENA_COOKIE_SECURE=false

# 同源部署的规范 origin，用于拒绝跨站写请求。示例：https://athena.example.com
# 留空时仅接受请求自身解析出的 origin；同源部署应显式配置。
ATHENA_PUBLIC_ORIGIN=http://127.0.0.1:8000

# 可选的 PostgreSQL 集成测试数据库。测试会创建并删除临时 schema。
ATHENA_TEST_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/athena_test
