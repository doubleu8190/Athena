# ── Athena Core Configuration ────────────────────────────────────────
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Number of uvicorn worker processes
UVICORN_WORKERS=4

# Number of athena-core replicas (for production scaling)
ATHENA_CORE_REPLICAS=1

# ARQ worker configuration
ARQ_WORKER_REPLICAS=2

# CORS origins (comma-separated)
CORS_ORIGINS=*

# ── Frontend Configuration ───────────────────────────────────────────
# Frontend port (only for development)
FRONTEND_PORT=80

# ── Database Configuration ───────────────────────────────────────────
# SQLite database path (inside container)
SQLITE_DB_PATH=/data/athena.db

# ── Redis Configuration ──────────────────────────────────────────────
# Redis URL (internal Docker network)
REDIS_URL=redis://redis:6379/0
ARQ_BROKER_URL=redis://redis:6379/1

# ── API Configuration ────────────────────────────────────────────────
# Admin API key (also set in secrets/admin_api_key)
# ADMIN_API_KEY=your-admin-api-key

# ── Telegram Gateway ────────────────────────────────────────────────
TELEGRAM_POLL_TIMEOUT=30
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── WeChat Gateway ──────────────────────────────────────────────────
# WECHAT_BOT_TOKEN=your-wechat-bot-token
# WECHAT_ILINK_BOT_ID=your-wechat-ilink-bot-id

# ── LLM Configuration ───────────────────────────────────────────────
# MIMO_API_KEY=your-mimo-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ── Security ────────────────────────────────────────────────────────
# ATHENA_ENCRYPTION_KEY=your-encryption-key

# ── Prometheus ──────────────────────────────────────────────────────
PROMETHEUS_ENABLED=true

# ── HuggingFace Cache ───────────────────────────────────────────────
HF_HOME=/data/huggingface
