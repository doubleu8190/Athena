# 应用数据库；设置后 create_app 会组装认证、项目、消息和 MCP 管理服务。
ATHENA_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/athena
# Run SSE 临时 Pub/Sub；未配置或 Redis 不可用时依赖 PostgreSQL 周期对账，不影响执行结果。
ATHENA_REDIS_URL=redis://127.0.0.1:6379/0
# 数据库默认组装 MCP 时必填。Generate with:
# python -c 'import base64,secrets; print(base64.b64encode(secrets.token_bytes(32)).decode())'
ATHENA_MCP_SECRET_KEY=
ATHENA_MCP_SECRET_KEY_VERSION=1
# 精确 host allowlist，仅在确需连接私网 MCP 时填写；默认拒绝私网目标。
ATHENA_MCP_ALLOWED_PRIVATE_HOSTS=
# 仅从宿主进程复制这些环境变量到 stdio 子进程；单 Server 凭据单独配置。
ATHENA_MCP_STDIO_BASE_ENV_NAMES=

# PostgreSQL 业务连接池容量。数据库行锁等待会占用一条业务连接。
ATHENA_DATABASE_POOL_SIZE=5
ATHENA_DATABASE_MAX_OVERFLOW=10

# 可选的 LLM Responses API Profile；API Key 通过环境变量名引用，不写入 JSON。
# 每个 Profile 必须提供 model、api_key_env 和 capabilities。
# ATHENA_LLM_PROFILES='{"assistant":{"model":"your-model","api_key_env":"OPENAI_API_KEY","capabilities":{"tools":true,"stream":true,"structured":true,"temperature":true}}}'
# OPENAI_API_KEY=

# Run 专用 Chat Completions 配置：管理员版本只允许引用此命名空间中的环境变量。
# 在数据库中创建模型版本时填写 credential_env=ATHENA_LLM_CREDENTIAL_DEFAULT。
# 请在部署环境的 secret manager 中注入实际值，不要提交密钥。
# ATHENA_LLM_CREDENTIAL_DEFAULT=

# 独立 Run Worker 参数；默认并发 4、租约 30 秒、每 5 秒续租。
# 执行总时限默认 300 秒；取消轮询、队列轮询和租约回收默认 1/1/5 秒。
ATHENA_RUN_WORKER_CONCURRENCY=4
ATHENA_RUN_LEASE_SECONDS=30
ATHENA_RUN_HEARTBEAT_SECONDS=5
ATHENA_RUN_EXECUTION_SECONDS=300
ATHENA_RUN_CANCEL_POLL_SECONDS=1
ATHENA_RUN_QUEUE_POLL_SECONDS=1
ATHENA_RUN_RECLAIM_SECONDS=5
# 每 Run 最多 40 次应用层 LLM 请求；单工具与结果/参数均默认 64 KiB。
# 工具清理最多额外 10 秒，工具超时还受当前执行段剩余时间限制。
ATHENA_RUN_LLM_REQUEST_LIMIT=40
ATHENA_RUN_TOOL_TIMEOUT_SECONDS=30
ATHENA_RUN_TOOL_ARGUMENT_BYTES=65536
ATHENA_RUN_TOOL_RESULT_BYTES=65536
ATHENA_RUN_TOOL_CLEANUP_SECONDS=10

# 登录 Cookie 是否仅通过 HTTPS 发送。仅本地 HTTP 开发可设为 false；
# 生产环境必须设为 true。
ATHENA_COOKIE_SECURE=false

# 同源部署的规范 origin，用于拒绝跨站写请求。示例：https://athena.example.com
# 留空时仅接受请求自身解析出的 origin；同源部署应显式配置。
ATHENA_PUBLIC_ORIGIN=http://127.0.0.1:8000

# 可选的 PostgreSQL 集成测试数据库。测试会创建并删除临时 schema。
ATHENA_TEST_DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/athena_test

# 知识库功能；API、knowledge_worker 和启用知识查询的 run_worker 共用同一数据库、
# 模型 revision 与私有 MinIO 桶。关闭时不会读取或校验下列 MinIO 配置。
ATHENA_KNOWLEDGE_ENABLED=false
# 必填 endpoint 为 host[:port]，不含协议、路径或凭据；桶必须预建且保持私有。
ATHENA_KNOWLEDGE_MINIO_ENDPOINT=
ATHENA_KNOWLEDGE_MINIO_ACCESS_KEY=
ATHENA_KNOWLEDGE_MINIO_SECRET_KEY=
ATHENA_KNOWLEDGE_MINIO_BUCKET=
# TLS 默认开启；只接受 true/false、1/0、yes/no、on/off。
ATHENA_KNOWLEDGE_MINIO_SECURE=true
# 私有 CA 可令 SSL_CERT_FILE 指向 CA 文件；未设置时使用系统信任库。
# SSL_CERT_FILE=/path/to/private-ca.pem
ATHENA_KNOWLEDGE_UPLOAD_MIN_FREE_BYTES=402653184
ATHENA_KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-m3
ATHENA_KNOWLEDGE_EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
ATHENA_KNOWLEDGE_EMBEDDING_DEVICE=cpu
ATHENA_KNOWLEDGE_WORKER_CONCURRENCY=2
ATHENA_KNOWLEDGE_OWNER_CONCURRENCY=2
ATHENA_KNOWLEDGE_PARSE_MEMORY_MB=4096
# Python 3.12 环境需预建可写目录，PaddleOCR 首次启动会缓存模型。
ATHENA_KNOWLEDGE_OCR_CACHE_ROOT=./var/paddle-cache

# 可选的真实 MinIO 集成测试；必须使用与生产不同的隔离桶。
# ATHENA_TEST_MINIO_ENDPOINT=
# ATHENA_TEST_MINIO_ACCESS_KEY=
# ATHENA_TEST_MINIO_SECRET_KEY=
# ATHENA_TEST_MINIO_BUCKET=
# ATHENA_TEST_MINIO_SECURE=true
