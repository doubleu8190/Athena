# ==============================================================================
# Athena v2 测试/预发联调环境配置模板 (.env.test.example)
# ==============================================================================
# 使用说明：
# 1. 复制本文件为测试配置文件：cp .env.test.example .env.test
# 2. 适用于本地 Docker 混合联调、CI 预发环境或轻量集成测试验证。
# 3. 执行命令（使用独立 Compose 项目名 `athena-test`，避免干扰现有开发或生产容器）：
#    - 执行测试库迁移: docker compose -p athena-test --env-file .env.test run --rm backend-api migrate
#    - 启动测试服务编排: docker compose -p athena-test --env-file .env.test up -d
#    - 查看测试日志:     docker compose -p athena-test --env-file .env.test logs -f
#    - 清理测试容器与卷: docker compose -p athena-test --env-file .env.test down -v
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 端口与网络映射（使用 8080 端口，避免与本地开发 80/8000/3000 端口冲突）
# ------------------------------------------------------------------------------
PORT=8080
ATHENA_INSTALL_KNOWLEDGE=false

# ------------------------------------------------------------------------------
# 2. 测试数据库连接 (PostgreSQL)
# ------------------------------------------------------------------------------
# 指向独立的 athena_test 测试库，通过 host.docker.internal 访问宿主机或测试依赖容器
ATHENA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@host.docker.internal:5432/athena_test

# 测试环境保持较小的连接池即可
ATHENA_DATABASE_POOL_SIZE=5
ATHENA_DATABASE_MAX_OVERFLOW=5

# ------------------------------------------------------------------------------
# 3. 测试缓存与事件通道 (Redis)
# ------------------------------------------------------------------------------
# 使用独立的 1 号数据库（db 1），避免污染默认开发缓存（db 0）
ATHENA_REDIS_URL=redis://host.docker.internal:6379/1

# ------------------------------------------------------------------------------
# 4. 安全、认证与 Origin 配置（便于本地 HTTP 联调与测试）
# ------------------------------------------------------------------------------
# 测试环境无需强制 HTTPS，设为 false 允许通过 http://localhost:8080 正常写入认证 Cookie
ATHENA_COOKIE_SECURE=false

# 允许本地测试访问来源
ATHENA_PUBLIC_ORIGIN=http://localhost:8080

# 测试环境预置便捷密钥（32 字节 Base64 字符串，解码后正好为 32 字节，仅供本地联调与测试使用）
ATHENA_MCP_SECRET_KEY=bW9jay10ZXN0LXNlY3JldC1rZXktMzItYnl0ZXMhISE=
ATHENA_MCP_SECRET_KEY_VERSION=1
ATHENA_MCP_ALLOWED_PRIVATE_HOSTS=
ATHENA_MCP_STDIO_BASE_ENV_NAMES=

# ------------------------------------------------------------------------------
# 5. Worker 测试并发与高频轮询配置
# ------------------------------------------------------------------------------
ATHENA_RUN_WORKER_CONCURRENCY=2
ATHENA_RUN_LEASE_SECONDS=15
ATHENA_RUN_HEARTBEAT_SECONDS=3
ATHENA_RUN_EXECUTION_SECONDS=120
ATHENA_RUN_CANCEL_POLL_SECONDS=1
ATHENA_RUN_QUEUE_POLL_SECONDS=1
ATHENA_RUN_RECLAIM_SECONDS=2

# ------------------------------------------------------------------------------
# 6. 对象存储：测试 MinIO 配置（按需开启）
# ------------------------------------------------------------------------------
ATHENA_FILES_ENABLED=false
ATHENA_FILE_MINIO_ENDPOINT=host.docker.internal:9000
ATHENA_FILE_MINIO_ACCESS_KEY=minioadmin
ATHENA_FILE_MINIO_SECRET_KEY=minioadmin
ATHENA_FILE_MINIO_BUCKET=athena-files-test
ATHENA_FILE_MINIO_SECURE=false

ATHENA_SKILL_TEMP_ROOT=/app/var/skill-executions
ATHENA_SKILL_TEMP_STALE_SECONDS=60
ATHENA_FILE_ORPHAN_RETENTION_SECONDS=86400
ATHENA_FILE_MAINTENANCE_INTERVAL_SECONDS=300

ATHENA_KNOWLEDGE_ENABLED=false
ATHENA_KNOWLEDGE_MINIO_ENDPOINT=host.docker.internal:9000
ATHENA_KNOWLEDGE_MINIO_ACCESS_KEY=minioadmin
ATHENA_KNOWLEDGE_MINIO_SECRET_KEY=minioadmin
ATHENA_KNOWLEDGE_MINIO_BUCKET=athena-knowledge-test
ATHENA_KNOWLEDGE_MINIO_SECURE=false

# ------------------------------------------------------------------------------
# 7. 日志级别：调试模式
# ------------------------------------------------------------------------------
# 设为 DEBUG，输出完整的请求路径、SQL 行为与调度流程以便排查测试问题
ATHENA_LOG_LEVEL=DEBUG
