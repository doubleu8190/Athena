# Dockerfile.base — Athena base image with language runtimes and Python packages
#
# Build:  docker build -f Dockerfile.base -t athena-base:latest .
# Rebuild only when pyproject.toml or system dependencies change.
#
# Runtimes: Python 3.14, JDK 21, Go 1.25, Node.js 26

FROM python:3.14-slim

WORKDIR /app

# ── System dependencies ──────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    gnupg \
    tzdata \
    openjdk-21-jdk-headless \
    && rm -rf /var/lib/apt/lists/*

# ── Node.js 26.x ─────────────────────────────────────────────────────
RUN curl -fsSL https://deb.nodesource.com/setup_26.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/*

# ── Go ───────────────────────────────────────────────────────────────
ARG GO_VERSION=1.25.11
ARG TARGETARCH=amd64
RUN curl -fsSL "https://go.dev/dl/go${GO_VERSION}.linux-${TARGETARCH}.tar.gz" \
    -o /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# ── Python dependencies ──────────────────────────────────────────────
# Reads pyproject.toml to resolve and install all dependencies
# (torch, transformers, chromadb, etc.)
COPY pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir . && \
    pip install --no-cache-dir alembic

# ── Non-root user and directories ────────────────────────────────────
RUN addgroup --system athena && \
    adduser --system --no-create-home --ingroup athena athena && \
    mkdir -p /data /workspace && \
    chown -R athena:athena /data /workspace

# ── Environment variables ────────────────────────────────────────────
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV SQLITE_DB_PATH=/data/athena.db
ENV DATA_DIR=/data
# HuggingFace cache — must be writable; home is /nonexistent for the system user
ENV HF_HOME=/data/huggingface
# npm/npx needs a writable home; /nonexistent doesn't exist
ENV HOME=/data
# Force npm cache to /tmp (tmpfs) — avoids corrupted cache from persisted volume
ENV npm_config_cache=/tmp/npm-cache

EXPOSE 8000
