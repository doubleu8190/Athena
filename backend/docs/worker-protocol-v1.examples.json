    "cancel_receipt_cannot_claim_stop_state": {
      "schema_ref": "CancelReceipt",
      "payload": {
        "protocol_version": "1.0",
        "command_id": "d1000000-0000-4000-8000-000000000001",
        "receipt_id": "cancel-receipt-timeout-001",
        "execution_id": "80000000-0000-4000-8000-000000000001",
        "generation": 1,
        "cancellation_epoch": 0,
        "reason": "execution_timed_out",
        "accepted": true,
        "stop_confirmation_required": true,
        "stopped": false,
        "received_at": "2026-10-30T08:01:12Z"
      },
      "expected": "reject; CancelReceipt records durable intent only, stop state belongs to StopConfirmation"
    }
  },
