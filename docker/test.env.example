# Docker 测试环境的唯一非敏感配置源；服务端口仅绑定 loopback。
# 本文件由 scripts/load-test-env.sh 读取，凭据值只从 secrets/ 注入。
PORT=8080

POSTGRES_DB=athena
POSTGRES_TEST_DB=athena_test
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEV_BUCKET=athena-storage-dev
MINIO_TEST_BUCKET=athena-storage-test

# 用户名、密码和连接 URL 由 scripts/load-test-env.sh 从 git 忽略的 secrets/
# 文件读取并按宿主机或容器目标生成，不写在此模板中。
ATHENA_ENV=development
ATHENA_COOKIE_SECURE=false
ATHENA_PUBLIC_ORIGIN=http://localhost:8080
ATHENA_LOG_LEVEL=DEBUG

# 非生产测试默认开启本地 Mock 多角色组织与快捷登录（/api/v1/auth/mock/*），便于免飞书凭据快速联调；
# 生产环境（ATHENA_ENV=production）禁止开启，否则 API 启动时直接阻断报错。
ATHENA_AUTH_MOCK_ENABLED=true

# 可选飞书原生 SSO 与通讯录同步配置（仅联调真实飞书应用时改为 true 并填入应用凭据）。
ATHENA_FEISHU_ENABLED=false
# ATHENA_FEISHU_APP_ID=
# ATHENA_FEISHU_APP_SECRET=
# ATHENA_FEISHU_REDIRECT_URI=http://localhost:8080/api/v1/auth/feishu/callback
# ATHENA_FEISHU_BASE_URL=https://open.feishu.cn

# 统一对象存储 TLS 开关（单桶按 knowledge/、session-files/、skills/ 前缀隔离）。
ATHENA_STORAGE_SECURE=false
ATHENA_TEST_MINIO_SECURE=false

# 知识库与文件能力已默认无条件装配，以下远程 Embedding 服务地址为必填项。
# 请填写容器可访问的 OpenAI 兼容 Embedding 服务地址，例如：
# - 宿主机 Ollama: http://host.docker.internal:11434/v1
# - 宿主机 vLLM/Xinference: http://host.docker.internal:8001/v1
# - 外部 OpenAI 兼容服务: https://api.example.com/v1
# ATHENA_INSTALL_KNOWLEDGE 仅控制是否在基础依赖镜像中安装重型本地 OCR（PaddlePaddle + PaddleOCR）；
# 轻量化文本解析与中文分词依赖（jieba/pypdfium2/docx/xlsx/pptx/Pillow）已内置为核心依赖。
ATHENA_INSTALL_KNOWLEDGE=true
ATHENA_EMBEDDING_BASE_URL=
ATHENA_EMBEDDING_API_KEY=
ATHENA_EMBEDDING_MODEL=BAAI/bge-m3
ATHENA_EMBEDDING_DIMENSIONS=1024
ATHENA_EMBEDDING_SEND_DIMENSIONS=true
ATHENA_EMBEDDING_TIMEOUT_SECONDS=30.0
ATHENA_EMBEDDING_BATCH_SIZE=32

# Skills 与会话文件复用统一 ATHENA_STORAGE_* 对象存储（单桶前缀隔离）。
ATHENA_SKILL_TEMP_ROOT=/app/var/skill-executions

ATHENA_DATABASE_POOL_SIZE=5
ATHENA_DATABASE_MAX_OVERFLOW=5
ATHENA_RUN_WORKER_CONCURRENCY=2
ATHENA_RUN_LEASE_SECONDS=15
ATHENA_RUN_HEARTBEAT_SECONDS=3
ATHENA_RUN_EXECUTION_SECONDS=120
ATHENA_RUN_CANCEL_POLL_SECONDS=1
ATHENA_RUN_QUEUE_POLL_SECONDS=1
ATHENA_RUN_RECLAIM_SECONDS=2

ATHENA_MCP_SECRET_KEY_VERSION=1
ATHENA_MCP_ALLOWED_PRIVATE_HOSTS=
ATHENA_MCP_STDIO_BASE_ENV_NAMES=
