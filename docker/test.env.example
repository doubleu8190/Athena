# Docker 测试环境的唯一非敏感配置源；服务端口仅绑定 loopback。
# 本文件由 scripts/load-test-env.sh 读取，凭据值只从 secrets/ 注入。
PORT=8080

POSTGRES_DB=athena
POSTGRES_TEST_DB=athena_test
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEV_BUCKET=athena-knowledge-dev
MINIO_TEST_BUCKET=athena-knowledge-test
MINIO_FILES_DEV_BUCKET=athena-files-dev
MINIO_FILES_TEST_BUCKET=athena-files-test

# 用户名、密码和连接 URL 由 scripts/load-test-env.sh 从 git 忽略的 secrets/
# 文件读取并按宿主机或容器目标生成，不写在此模板中。
ATHENA_COOKIE_SECURE=false
ATHENA_PUBLIC_ORIGIN=http://localhost:8080
ATHENA_LOG_LEVEL=DEBUG

# 本地测试默认启用知识库；首次启动会启动 Knowledge Worker 并加载/下载嵌入模型。
ATHENA_KNOWLEDGE_ENABLED=true
ATHENA_INSTALL_KNOWLEDGE=true
ATHENA_KNOWLEDGE_MINIO_SECURE=false
ATHENA_TEST_MINIO_SECURE=false

# Skills 与会话文件可复用同一 MinIO 服务，但使用独立 bucket 和配置前缀。
ATHENA_FILES_ENABLED=true
ATHENA_FILE_MINIO_SECURE=false
ATHENA_SKILL_TEMP_ROOT=/app/var/skill-executions
ATHENA_SKILL_TEMP_STALE_SECONDS=60
ATHENA_FILE_ORPHAN_RETENTION_SECONDS=86400
ATHENA_FILE_MAINTENANCE_INTERVAL_SECONDS=300

ATHENA_DATABASE_POOL_SIZE=5
ATHENA_DATABASE_MAX_OVERFLOW=5
ATHENA_RUN_WORKER_CONCURRENCY=2
ATHENA_RUN_LEASE_SECONDS=15
ATHENA_RUN_HEARTBEAT_SECONDS=3
ATHENA_RUN_EXECUTION_SECONDS=120
ATHENA_RUN_CANCEL_POLL_SECONDS=1
ATHENA_RUN_QUEUE_POLL_SECONDS=1
ATHENA_RUN_RECLAIM_SECONDS=2

ATHENA_MCP_SECRET_KEY_VERSION=1
ATHENA_MCP_ALLOWED_PRIVATE_HOSTS=
ATHENA_MCP_STDIO_BASE_ENV_NAMES=
