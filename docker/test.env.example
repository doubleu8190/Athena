# 本机测试依赖的非敏感设置；仅将服务端口绑定到 loopback。
POSTGRES_DB=athena
POSTGRES_TEST_DB=athena_test
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_DEV_BUCKET=athena-knowledge-dev
MINIO_TEST_BUCKET=athena-knowledge-test

# 本地 API 与集成测试配置。用户名、密码和连接 URL 由 scripts/load-test-env.sh
# 从 git 忽略的 secrets/ 文件读取并生成，不写在此模板中。
ATHENA_COOKIE_SECURE=false
ATHENA_PUBLIC_ORIGIN=http://127.0.0.1:8000
# 本地测试默认启用知识库；首次启动会启动 Knowledge Worker 并加载/下载嵌入模型。
ATHENA_KNOWLEDGE_ENABLED=true
ATHENA_KNOWLEDGE_MINIO_SECURE=false
ATHENA_TEST_MINIO_SECURE=false
ATHENA_MCP_SECRET_KEY_VERSION=1
